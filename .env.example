# Application mode
APP_ENV=production
SESSION_COOKIE_SECURE=1
ALLOW_DEV_OTP=0

# Generate a long random value. Never commit the real value.
FLASK_SECRET_KEY=replace-with-a-long-random-value

# Change both values before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Railway persistent volume mount path.
DATA_DIR=/data

# Optional. If omitted, a key is generated inside DATA_DIR.
# FERNET_KEY=replace-with-a-valid-fernet-key

# Required for OTP delivery on Railway through Brevo's HTTPS API.
BREVO_API_KEY=replace-with-your-real-brevo-api-key
OTP_FROM_EMAIL=replace-with-your-verified-sender-email

# Optional SMTP fallback for local use or hosts that allow outbound SMTP.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=replace-with-your-smtp-user
# SMTP_PASS=replace-with-your-smtp-password
